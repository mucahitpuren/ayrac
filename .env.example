# Ayrac environment variables. Copy the section you need into the file named
# in its heading. Everything below is a DUMMY example value; never commit real keys.

# --- (a) Client: copy to .env.local, used by `npm run dev` and bundled into the app ---
VITE_SUPABASE_URL=https://your-dev-project-ref.supabase.co
# Client-safe key only: the `sb_publishable_...` key or the legacy `anon` JWT.
# It must NEVER be the secret / service-role key (that would be public in the bundle).
VITE_SUPABASE_ANON_KEY=your-publishable-or-anon-key

# --- (b) Integration tests: copy to .env.test.local. Dev project ONLY (D-12) ---
# Never point these at the production project. SUPABASE_PROD_PROJECT_REF is used only
# by the guard that refuses to run the tests when TEST_SUPABASE_URL points at prod.
TEST_SUPABASE_URL=https://your-dev-project-ref.supabase.co
TEST_SUPABASE_ANON_KEY=your-dev-publishable-or-anon-key
TEST_SUPABASE_SERVICE_ROLE_KEY=your-dev-service-role-key
SUPABASE_PROD_PROJECT_REF=your-prod-project-ref

# --- (c) Supabase CLI: copy to .env.supabase.local (migrations, link, db push) ---
SUPABASE_DEV_PROJECT_REF=your-dev-project-ref
SUPABASE_PROD_PROJECT_REF=your-prod-project-ref
SUPABASE_DEV_DB_PASSWORD=your-dev-database-password
SUPABASE_PROD_DB_PASSWORD=your-prod-database-password
